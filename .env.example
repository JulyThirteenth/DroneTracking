# LLM Configuration for Embodied Agent
# =====================================
#
# LLM_PROVIDER    - 接口类型: OPENAI (默认) 或 GOOGLE
# LLM_API_KEY     - API 密钥（必填）
# LLM_BASE_URL    - API 基础地址（可选，根据 provider 有默认值）
# LLM_MODEL       - 模型名称（可选，根据 provider 有默认值）
# LLM_TEMPERATURE - 温度参数（可选，默认 0.7）

LLM_PROVIDER=GOOGLE
LLM_API_KEY=your-google-api-key-here
# LLM_BASE_URL=
LLM_MODEL=gemini-2.5-pro
# LLM_TEMPERATURE=0.7
